# Ad-hoc profile for publishGit.mjs (node scripts/publishGit.mjs <id> <profile>).
# Everyday `pnpm publish:git` does NOT use this file: it reads mls-base/.env
# (PUBLISH_LOCAL_SSH_HOST, PUBLISH_LOCAL_SSH_CONFIG, PUBLISH_LOCAL_REMOTE_BASE).
# Real servers/*.conf files are gitignored.

# Required: ssh target.
#SSH_HOST=ubuntu@192.168.5.15
#SSH_CONFIG=./servers/collab.codes
#SSH_HOST=collab.codes

# example with lima
SSH_HOST=lima-ubuntu24
SSH_CONFIG=$HOME/.lima/ubuntu24/ssh.config
REMOTE_BASE=/data/mls-base